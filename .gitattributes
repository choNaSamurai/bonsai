# Normalize line endings for text
* text=auto eol=lf

# ---------- Unity YAML (Force Text serialization) ----------
# Smart merge via UnityYAMLMerge — configure once per machine (see docs/process/GIT_WORKFLOW.md)
*.unity        text merge=unityyamlmerge eol=lf linguist-generated
*.prefab       text merge=unityyamlmerge eol=lf linguist-generated
*.asset        text merge=unityyamlmerge eol=lf linguist-generated
*.mat          text merge=unityyamlmerge eol=lf linguist-generated
*.anim         text merge=unityyamlmerge eol=lf linguist-generated
*.controller   text merge=unityyamlmerge eol=lf linguist-generated
*.overrideController text merge=unityyamlmerge eol=lf linguist-generated
*.physicMaterial text merge=unityyamlmerge eol=lf linguist-generated
*.mixer        text merge=unityyamlmerge eol=lf linguist-generated
*.playable     text merge=unityyamlmerge eol=lf linguist-generated
*.lighting     text merge=unityyamlmerge eol=lf linguist-generated
*.spriteatlas  text merge=unityyamlmerge eol=lf linguist-generated
*.spriteatlasv2 text merge=unityyamlmerge eol=lf linguist-generated
*.shadergraph  text eol=lf linguist-generated
*.shadersubgraph text eol=lf linguist-generated
*.meta         text eol=lf linguist-generated

# Code
*.cs     text diff=csharp eol=lf
*.shader text eol=lf
*.hlsl   text eol=lf
*.cginc  text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.json   text eol=lf
*.swift  text eol=lf
*.kt     text eol=lf
*.java   text eol=lf
*.m      text eol=lf
*.mm     text eol=lf
*.gradle text eol=lf
*.md     text eol=lf
*.sh     text eol=lf

# ---------- Git LFS (binary assets) ----------
# Requires: brew install git-lfs && git lfs install
# Images
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.psd  filter=lfs diff=lfs merge=lfs -text lockable
*.psb  filter=lfs diff=lfs merge=lfs -text lockable
*.tga  filter=lfs diff=lfs merge=lfs -text
*.tif  filter=lfs diff=lfs merge=lfs -text
*.exr  filter=lfs diff=lfs merge=lfs -text
*.hdr  filter=lfs diff=lfs merge=lfs -text
*.kra  filter=lfs diff=lfs merge=lfs -text lockable
*.afdesign filter=lfs diff=lfs merge=lfs -text lockable
*.blend filter=lfs diff=lfs merge=lfs -text lockable
# Audio
*.wav  filter=lfs diff=lfs merge=lfs -text
*.ogg  filter=lfs diff=lfs merge=lfs -text
*.opus filter=lfs diff=lfs merge=lfs -text
*.mp3  filter=lfs diff=lfs merge=lfs -text
*.aif  filter=lfs diff=lfs merge=lfs -text
*.aiff filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
# Fonts
*.ttf   filter=lfs diff=lfs merge=lfs -text
*.otf   filter=lfs diff=lfs merge=lfs -text
*.woff2 filter=lfs diff=lfs merge=lfs -text
# 3D / video
*.fbx  filter=lfs diff=lfs merge=lfs -text
*.obj  filter=lfs diff=lfs merge=lfs -text
*.mp4  filter=lfs diff=lfs merge=lfs -text
*.mov  filter=lfs diff=lfs merge=lfs -text
# Native libraries / archives
*.a     filter=lfs diff=lfs merge=lfs -text
*.so    filter=lfs diff=lfs merge=lfs -text
*.dll   filter=lfs diff=lfs merge=lfs -text
*.aar   filter=lfs diff=lfs merge=lfs -text
*.jar   filter=lfs diff=lfs merge=lfs -text
*.zip   filter=lfs diff=lfs merge=lfs -text
*.pdf   filter=lfs diff=lfs merge=lfs -text

# Scenes are binary-merge-hostile even as YAML: lock them while editing
*.unity lockable
